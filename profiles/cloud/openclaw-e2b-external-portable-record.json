{
  "name": "openclaw-e2b-external-portable-record",
  "agent_type": "openclaw",
  "placement": "external",
  "sandbox_backend": "e2b-cloud",
  "versions_file": "../../configs/versions.json",
  "output_dir": "runs",
  "harness": {
    "openclaw_path": "/usr/local/bin/openclaw",
    "openclaw_version": "2026.7.1",
    "ssh_client_path": "../../bin/aries-ssh-client"
  },
  "model": {
    "mode": "record",
    "tool_call_id_dialect": "openclaw-2026.7.1",
    "max_turns": 32
  },
  "execution": {
    "concurrency": 1,
    "attempts": 1,
    "task_timeout": "5m",
    "verifier_timeout": "1m"
  },
  "workload": "merge-ranges-portable-v1"
}
