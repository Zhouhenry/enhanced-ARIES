{
  "name": "openclaw-agentsphere-external-portable-replay",
  "agent_type": "openclaw",
  "placement": "external",
  "sandbox_backend": "huawei-agentsphere",
  "versions_file": "../../configs/versions.json",
  "output_dir": "runs",
  "harness": {
    "openclaw_path": "/usr/local/bin/openclaw",
    "openclaw_version": "2026.7.1",
    "ssh_client_path": "../../bin/aries-ssh-client"
  },
  "model": {
    "mode": "replay",
    "tool_call_id_dialect": "openclaw-2026.7.1",
    "timing": "recorded",
    "tape_file": "../../runs/PORTABLE_RECORD_RUN/merge-ranges-portable-v1-001/model/tape.json"
  },
  "execution": {
    "concurrency": 1,
    "attempts": 1,
    "task_timeout": "5m",
    "verifier_timeout": "1m"
  },
  "sandbox": {
    "token_env": "ARIES_HUAWEI_ADAPTER_TOKEN"
  },
  "workload": "merge-ranges-portable-v1"
}
