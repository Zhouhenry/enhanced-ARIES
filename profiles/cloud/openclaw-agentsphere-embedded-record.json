{
  "name": "openclaw-agentsphere-embedded-record",
  "agent_type": "openclaw",
  "placement": "embedded",
  "sandbox_backend": "huawei-agentsphere",
  "versions_file": "../../configs/versions.json",
  "output_dir": "runs",
  "harness": {
    "openclaw_path": "/usr/local/bin/openclaw",
    "openclaw_version": "2026.7.1"
  },
  "model": {
    "mode": "record",
    "tool_call_id_dialect": "openclaw-2026.7.1",
    "max_turns": 32
  },
  "execution": {
    "concurrency": 1,
    "attempts": 1,
    "task_timeout": "5m",
    "verifier_timeout": "1m"
  },
  "sandbox": {
    "token_env": "ARIES_HUAWEI_ADAPTER_TOKEN"
  }
}
