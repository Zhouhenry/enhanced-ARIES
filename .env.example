# ARIES: E2B Cloud + OpenClaw + DeepSeek
# 将本模板复制为仓库根目录 .env；本轮已为你创建该私有文件。
# 只填写 KEY=value，不写 export。勿把密钥发到聊天、提交 Git 或放进 profile。
# 不执行 shell 插值；含空格或 # 的值请用单引号包裹。

# 必填 1/3：E2B 官方 Cloud 的 API key。
E2B_API_KEY=

# 华为云 AgentSphere：独立 Adapter 接入配置；原 E2B Cloud 流程不读取这些项。
# 禁止出网尚未验证有效；假设模式的评分结果不能作为已验证隔离的基线。
# 填华为云 AgentSphere API Key，与上面的 E2B 官方 Cloud Key 分开保存。
HUAWEI_AGENTSPHERE_API_KEY=
# 本账户已确认使用下面的控制面地址；不自动替换为官网其他域名。
HUAWEI_AGENTSPHERE_API_URL=https://agentsandbox.cn-southwest-2.myhuaweicloud.com
# 已有 Agent Gateway 的 HTTPS 公网域名与实例 ID；域名需与模板绑定的网关一致。
HUAWEI_AGENTSPHERE_GATEWAY_URL=
HUAWEI_AGENTSPHERE_GATEWAY_ID=
# 默认拒绝未验证的禁止出网分配；只接受小写 true/false。
# 显式设 true 时，profile 的 sandbox.assume_network_isolation 也须为 true。
# 仅允许继续实验，仍向平台发送 allow_internet_access=false，结果标为 assumed/unverified。
HUAWEI_AGENTSPHERE_ASSUME_NETWORK_ISOLATION=false
# 固定模板ID:构建ID，由镜像/模板准备流程生成，不复用 E2B_TEMPLATE_ID。
HUAWEI_SANDBOX_TEMPLATE_ID=
# 独立评分的受限出站 VPC 模板，格式 TemplateID:BuildID。
# 供后续出站隔离核验；当前 CLI/Adapter/Compose 尚不读取，不代表已支持禁止出网。
HUAWEI_VERIFIER_TEMPLATE_ID=
# ECS 内部独立入口和高熵认证令牌；不向公网开放，不复用 E2B Adapter 状态卷。
ARIES_HUAWEI_ADAPTER_URL=http://127.0.0.1:8788
ARIES_HUAWEI_ADAPTER_TOKEN=

# 华为云网络准备：IAM AK/SK（区别于 AgentSphere API Key）。
# 仅供 ECS 上创建/核验专用 VPC、子网、安全组；不注入 Agent/模型或产品运行容器。
# 控制台下载的长期 AK/SK：SECURITY_TOKEN 留空；临时凭据三项需同时填写。
# PROJECT_ID 填 cn-southwest-2 区域项目 ID。
# 当前 CLI/Adapter/Compose 尚不读取这些准备字段；勿在聊天中粘贴凭据。
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
HUAWEICLOUD_SDK_SECURITY_TOKEN=
HUAWEICLOUD_SDK_PROJECT_ID=

# 华为云 SWR：镜像发布准备项，当前 CLI/Adapter/Compose 不读取。
# REGISTRY 只填仓库域名，不带协议或路径；推送认证优先使用 ECS 现有配置。
HUAWEI_SWR_REGISTRY=
# 可选：控制台生成的完整临时 docker login 命令；包含密钥，仅存私有 .env。
# 发布准备仅解析登录参数，使用 password-stdin 在 ECS 登录，不通过 shell 执行该值。
HUAWEI_SWR_LOGIN_COMMAND=
# 已有组织名称（镜像路径中的 namespace），登录账户需有推送权限。
HUAWEI_SWR_NAMESPACE=
# 可选：临时凭据到期时间，使用带时区的 ISO 8601，如 2026-10-24T12:00:00+08:00。
HUAWEI_SWR_EXPIRES_AT=

# 必填 2/3：DeepSeek API key。真实供应商密钥只留在平台侧模型代理。
DEEPSEEK_API_KEY=

# 必填 3/3：你账户实际可用且支持工具调用的模型 ID；不预设模型名。
DEEPSEEK_MODEL=

# DeepSeek 官方 API 基址；如有已授权的兼容入口，可替换。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可先留空：由开发流程构建、验证并归档 E2B template，再填写完整模板引用。
# 固定实验构建使用 模板ID:构建ID；只有自定义 tag 的模板不能省略版本部分。
# SDK smoke 与正式 A/B 均使用此模板，不自动回退到 SDK 默认模板。
# OpenClaw 镜像和模板准备由开发流程负责，无需用户自行制作。
E2B_TEMPLATE_ID=

# 可先留空：A/B 访问平台模型代理的 HTTPS origin，可用 https://公网IP 或域名。
# 后续部署确定；不带路径、query、fragment，不能填 localhost 或携带凭据。
ARIES_MODEL_PROXY_PUBLIC_URL=
# 用公网 IP 时必填相同的裸 IP；用于 ECS NAT 下无 SNI 的 TLS 客户端。
# 域名方式可填相同域名；不带协议、端口或路径。只传给 Caddy。
ARIES_MODEL_PROXY_TLS_NAME=

# ECS 上 SDK Adapter 的回环入口；Runner 的 host network 与 Compose 配置一致。
ARIES_E2B_ADAPTER_URL=http://127.0.0.1:8787

# 平台内部认证凭据：本轮创建的 .env 已随机生成，无需手填。
# 本示例故意不含值；手动复制时必须生成不同的高熵随机值。
ARIES_E2B_ADAPTER_TOKEN=
ARIES_REPLAY_ACCESS_TOKEN=

# 首轮验证的资源上限；这些不是性能目标或厂商配额声明。
# 先串行、小样本；显式并发测试时才提高并发。
ARIES_MAX_CONCURRENCY=1
ARIES_MAX_SANDBOXES=4
# Adapter 保留累计创建记录，不设累计次数上限；完整 attempt 通常创建 task + verifier。
# 用后默认删除并查询确认；取消/失败也清理。未知清理结果必须核对，不清空账本重试。
# 模板启动验证和 SDK smoke 也会创建资源；并发与 TTL 限制不是美元硬预算。
ARIES_MAX_ATTEMPTS=2
# 云端 TTL 到期 kill，作为控制端崩溃的兜底；正常完成立即清理，不等到 TTL。
ARIES_SANDBOX_TIMEOUT_SECONDS=600

# 可选：Goodput 截止秒数，从计划到达到稳定产物就绪；须独立验证 PASS。
# 留空表示不计算 Goodput；不能以 AgentTimeout 自动替代。
ARIES_GOODPUT_DEADLINE_SECONDS=

# ECS 远程开发/部署机器：创建好 Linux 主机后填写；无需云账号 AK/SK。
# 编译、测试、镜像构建、部署和实验统一在 ECS 执行；本地只编辑与静态检查。
# SSH 主机填可从本机连接的 IP 或域名，不带 ssh://。
ARIES_ECS_SSH_HOST=94.74.91.208
# ECS 的私网网卡 IP，供外置 OpenClaw 容器访问受控 SSH Bridge；不要填公网 IP。
ARIES_ECS_PRIVATE_IP=
ARIES_ECS_SSH_PORT=8228
# 工作站可选 SOCKS5 出口；当前辅助脚本只接受 socks5://127.0.0.1:端口。
# 留空不覆盖已有 SSH 代理配置。该设置不影响模型请求，也不传入 ECS 服务或 Sandbox。
ARIES_ECS_SSH_PROXY=
# 云镜像实际登录用户，例如 ubuntu；按你创建的镜像填写。
ARIES_ECS_SSH_USER=root
# 本机 SSH 私钥的绝对路径；只填路径，不粘贴私钥。使用 ssh-agent 时可留空。
ARIES_ECS_SSH_IDENTITY_FILE=
# 密码登录时填写；使用密钥或 ssh-agent 时留空。只保存在本机私有 .env，不传入容器。
# 含特殊字符可用单引号包裹整个值；读取时按字面值处理，不执行 shell 展开。
ARIES_ECS_SSH_PASSWORD=
# ECS 上存放代码、Compose 和私有运行数据的绝对路径；登录用户需有写入权限。
ARIES_ECS_DEPLOY_DIR=/opt/aries-agent-bench
# ECS 需能安装/运行 Docker + Compose 并访问 E2B、DeepSeek 和镜像仓库。
# Embedded 模式需由 E2B 访问经认证的 HTTPS 模型代理；地址填上面的
# ARIES_MODEL_PROXY_PUBLIC_URL。SDK Adapter 和 Docker Socket 不开放到公网。
