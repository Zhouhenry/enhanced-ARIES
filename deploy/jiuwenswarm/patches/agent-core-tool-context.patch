+# Invocation identity is separate from ToolCard.id and never inferred from spans.
+_current_tool_call = ContextVar("current_tool_call", default=None)
+
+
+class _ToolCallScope:
+    def __init__(self, tool_call_id):
+        self.tool_call_id = tool_call_id if isinstance(tool_call_id, str) and tool_call_id else None
+        self.active = True
+
+
+def get_current_tool_call_id():
+    """Return the exact active invocation ID, including across child tasks."""
+    scope = _current_tool_call.get()
+    return scope.tool_call_id if scope is not None and scope.active else None
+
+
+def _with_invoke_context(fn):
+    @wraps(fn)
+    async def invoke(*args, **kwargs):
+        scope = _ToolCallScope(kwargs.get("tool_call_id"))
+        token = _current_tool_call.set(scope)
+        try:
+            return await fn(*args, **kwargs)
+        finally:
+            scope.active = False
+            _current_tool_call.reset(token)
+    return invoke
+
+
+def _with_stream_context(fn):
+    if not inspect.isasyncgenfunction(fn):
+        return _with_invoke_context(fn)
+
+    @wraps(fn)
+    async def stream(*args, **kwargs):
+        scope = _ToolCallScope(kwargs.get("tool_call_id"))
+        source = fn(*args, **kwargs)
+        try:
+            while True:
+                token = _current_tool_call.set(scope)
+                try:
+                    item = await anext(source)
+                except StopAsyncIteration:
+                    return
+                finally:
+                    _current_tool_call.reset(token)
+                # A suspended generator must not assign its identity to its consumer.
+                yield item
+        finally:
+            token = _current_tool_call.set(scope)
+            try:
+                await source.aclose()
+            finally:
+                scope.active = False
+                _current_tool_call.reset(token)
+    return stream
 
 
